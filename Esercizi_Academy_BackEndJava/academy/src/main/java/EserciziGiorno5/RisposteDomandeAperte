for (int n : numeri) {
    System.out.println(n);

}

for (int i = 0; i < 5; i++) {
    System.out.println(i);

}

// do-while (post-condizionale)
do {
    // eseguito almeno una volta

} while (condizione);

while (condizione) {
    // eseguito finché la condizione è true
}

